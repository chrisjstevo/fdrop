<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.fdrop</groupId>
    <artifactId>fdrop-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fdrop-http-client-dotnet</artifactId>
  <name>fdrop-http-client-dotnet</name>
  <description>The .NET client for fdrop's REST API (NuGet package Fdrop.Client), built with the dotnet CLI</description>

  <properties>
    <!-- the dotnet CLI; the SDK version comes from global.json -->
    <dotnet.executable>dotnet</dotnet.executable>
    <!-- -Ddotnet.skip skips this module, for machines without the .NET SDK; CI never sets it -->
    <dotnet.skip>false</dotnet.skip>
    <dotnet.skipTests>false</dotnet.skipTests>
    <dotnet.skipITs>false</dotnet.skipITs>
    <dotnet.configuration>Release</dotnet.configuration>
    <dotnet.coverage.minimum>0.85</dotnet.coverage.minimum>
    <!-- no Java sources of its own: only the test server in src/test/java -->
    <maven.main.skip>true</maven.main.skip>
    <test.server.dir>${project.build.directory}/test-server</test.server.dir>
    <coverage.dir>${project.build.directory}/coverage/</coverage.dir>
  </properties>

  <dependencies>
    <!-- ClientTestServer: a real fdrop server for the integration tests; test scope, never in the package -->
    <dependency>
      <groupId>io.fdrop</groupId>
      <artifactId>fdrop-http</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.fdrop</groupId>
      <artifactId>fdrop-storage-local</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.fdrop</groupId>
      <artifactId>fdrop-search</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.fdrop</groupId>
      <artifactId>fdrop-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>dotnet-skip</id>
      <activation><property><name>dotnet.skip</name></property></activation>
      <properties>
        <dotnet.skipTests>true</dotnet.skipTests>
        <dotnet.skipITs>true</dotnet.skipITs>
      </properties>
    </profile>
    <profile>
      <id>dotnet-skip-tests</id>
      <activation><property><name>skipTests</name></property></activation>
      <properties>
        <dotnet.skipTests>true</dotnet.skipTests>
        <dotnet.skipITs>true</dotnet.skipITs>
      </properties>
    </profile>
    <profile>
      <id>dotnet-skip-its</id>
      <activation><property><name>skipITs</name></property></activation>
      <properties>
        <dotnet.skipITs>true</dotnet.skipITs>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <!-- 0.1.0-SNAPSHOT becomes the NuGet version 0.1.0-dev; a release keeps its version -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>nuget-version</id>
            <phase>initialize</phase>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>nuget.version</name>
              <value>${project.version}</value>
              <regex>-SNAPSHOT$</regex>
              <replacement>-dev</replacement>
              <failIfNoMatch>false</failIfNoMatch>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- the module's output is the NuGet package; there is no jar -->
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <workingDirectory>${project.basedir}</workingDirectory>
          <environmentVariables>
            <DOTNET_CLI_TELEMETRY_OPTOUT>1</DOTNET_CLI_TELEMETRY_OPTOUT>
            <DOTNET_NOLOGO>1</DOTNET_NOLOGO>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <id>dotnet-version</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skip}</skip>
              <executable>${dotnet.executable}</executable>
              <arguments><argument>--version</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>dotnet-restore</id>
            <phase>compile</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skip}</skip>
              <executable>${dotnet.executable}</executable>
              <arguments>
                <argument>restore</argument>
                <argument>--locked-mode</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>dotnet-build</id>
            <phase>compile</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skip}</skip>
              <executable>${dotnet.executable}</executable>
              <arguments>
                <argument>build</argument>
                <argument>-c</argument>
                <argument>${dotnet.configuration}</argument>
                <argument>--no-restore</argument>
                <argument>-p:Version=${nuget.version}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>dotnet-unit-tests</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skipTests}</skip>
              <executable>${dotnet.executable}</executable>
              <arguments>
                <argument>test</argument>
                <argument>tests/Fdrop.Client.Tests</argument>
                <argument>-c</argument>
                <argument>${dotnet.configuration}</argument>
                <argument>--no-build</argument>
                <argument>--filter</argument>
                <argument>Category=Unit</argument>
                <argument>-p:CollectCoverage=true</argument>
                <argument>-p:CoverletOutput=${coverage.dir}</argument>
                <argument>-p:CoverletOutputFormat=json</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- a real fdrop server for the integration tests: clean, start in the background, wait until it is up -->
          <execution>
            <id>test-server-clean</id>
            <phase>pre-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skipITs}</skip>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-classpath</argument><classpath/>
                <argument>io.fdrop.client.dotnet.ClientTestServer</argument>
                <argument>--clean</argument>
                <argument>${test.server.dir}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>test-server-start</id>
            <phase>pre-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skipITs}</skip>
              <async>true</async>
              <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <outputFile>${test.server.dir}/server.log</outputFile>
              <arguments>
                <argument>-classpath</argument><classpath/>
                <argument>io.fdrop.client.dotnet.ClientTestServer</argument>
                <argument>--run</argument>
                <argument>${test.server.dir}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>test-server-await</id>
            <phase>pre-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skipITs}</skip>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-classpath</argument><classpath/>
                <argument>io.fdrop.client.dotnet.ClientTestServer</argument>
                <argument>--await</argument>
                <argument>${test.server.dir}</argument>
                <argument>120</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- for developers: the same server in the foreground, until Ctrl-C
               (../mvnw -pl fdrop-http-client-dotnet test-compile exec:exec@test-server) -->
          <execution>
            <id>test-server</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-classpath</argument><classpath/>
                <argument>io.fdrop.client.dotnet.ClientTestServer</argument>
                <argument>--run</argument>
                <argument>${test.server.dir}</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- failures are judged in verify, after the server is stopped, as failsafe does -->
          <execution>
            <id>dotnet-integration-tests</id>
            <phase>integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skipITs}</skip>
              <executable>${dotnet.executable}</executable>
              <successCodes><successCode>0</successCode><successCode>1</successCode></successCodes>
              <environmentVariables>
                <DOTNET_CLI_TELEMETRY_OPTOUT>1</DOTNET_CLI_TELEMETRY_OPTOUT>
                <DOTNET_NOLOGO>1</DOTNET_NOLOGO>
                <FDROP_TEST_SERVER>${test.server.dir}/server.json</FDROP_TEST_SERVER>
              </environmentVariables>
              <arguments>
                <argument>test</argument>
                <argument>tests/Fdrop.Client.Tests</argument>
                <argument>-c</argument>
                <argument>${dotnet.configuration}</argument>
                <argument>--no-build</argument>
                <argument>--filter</argument>
                <argument>Category=Integration</argument>
                <argument>--logger</argument>
                <argument>trx;LogFileName=integration.trx</argument>
                <argument>--results-directory</argument>
                <argument>${project.build.directory}/test-results</argument>
                <argument>-p:CollectCoverage=true</argument>
                <argument>-p:CoverletOutput=${coverage.dir}</argument>
                <argument>-p:MergeWith=${coverage.dir}coverage.json</argument>
                <argument>-p:CoverletOutputFormat=cobertura</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>test-server-stop</id>
            <phase>post-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skipITs}</skip>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-classpath</argument><classpath/>
                <argument>io.fdrop.client.dotnet.ClientTestServer</argument>
                <argument>--stop</argument>
                <argument>${test.server.dir}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>dotnet-test-results</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skipITs}</skip>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-classpath</argument><classpath/>
                <argument>io.fdrop.client.dotnet.ClientTestServer</argument>
                <argument>--check</argument>
                <argument>${project.build.directory}</argument>
                <argument>${dotnet.coverage.minimum}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>dotnet-pack</id>
            <phase>package</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${dotnet.skip}</skip>
              <executable>${dotnet.executable}</executable>
              <arguments>
                <argument>pack</argument>
                <argument>src/Fdrop.Client</argument>
                <argument>-c</argument>
                <argument>${dotnet.configuration}</argument>
                <argument>--no-build</argument>
                <argument>-p:Version=${nuget.version}</argument>
                <argument>-o</argument>
                <argument>${project.build.directory}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
