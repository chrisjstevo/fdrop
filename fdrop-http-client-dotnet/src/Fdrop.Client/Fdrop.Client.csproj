<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Fdrop.Client</RootNamespace>
    <AssemblyName>Fdrop.Client</AssemblyName>
    <!-- a portable library: no runtime identifier, trimming and Native AOT safe -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- records document only the parameters that need explaining -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>

    <PackageId>Fdrop.Client</PackageId>
    <Authors>fdrop</Authors>
    <Description>A .NET client for fdrop's REST API: resumable chunked uploads behind a single upload call, with retries.</Description>
    <PackageTags>fdrop;file-transfer;upload;resumable</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Fdrop.Client.Tests" />
  </ItemGroup>

</Project>
