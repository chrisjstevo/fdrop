# Every secret the deployment needs, generated by OpenTofu (see "Kubernetes deployment" in spec/kubernetes.md). The values live
# only in the encrypted state and in the Kubernetes Secrets the other modules write; none is ever in a file in Git.
# To rotate one: tofu apply -replace='module.secrets.random_password.<name>'

resource "random_password" "keycloak_admin" {
  length  = 32
  special = false
}

resource "random_password" "keycloak_db" {
  length  = 32
  special = false
}

resource "random_password" "web_client" {
  length  = 40
  special = false
}

resource "random_password" "sftp_client" {
  length  = 40
  special = false
}

resource "random_password" "metrics_token" {
  length  = 48
  special = false
}

# 32-byte keys, base64 as fdrop reads them
resource "random_bytes" "forward_key" {
  length = 32
}

resource "random_bytes" "storage_kek" {
  length = 32
}

# Garage: hex secrets as it expects them, and an S3 key in its format (GK + 24 hex characters, 64 hex secret)
resource "random_bytes" "garage_rpc" {
  length = 32
}

resource "random_password" "garage_admin" {
  length  = 48
  special = false
}

resource "random_password" "garage_metrics" {
  length  = 48
  special = false
}

resource "random_bytes" "s3_key_id" {
  length = 12
}

resource "random_bytes" "s3_secret" {
  length = 32
}

# The SFTP host key: the same on every fdrop pod, so clients see one host key whichever pod answers
resource "tls_private_key" "sftp_host" {
  algorithm = "ED25519"
}
