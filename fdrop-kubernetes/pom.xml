<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.fdrop</groupId>
    <artifactId>fdrop-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fdrop-kubernetes</artifactId>
  <packaging>pom</packaging>
  <name>fdrop-kubernetes</name>
  <description>Reference Kubernetes deployment of fdrop, in OpenTofu: checked and tested with tofu in the build</description>

  <properties>
    <!-- the tofu CLI; empty means check.sh finds the version in .opentofu-version, or fetches it -->
    <tofu.executable></tofu.executable>
    <tofu.skip>false</tofu.skip>
    <tofu.skipTests>${skipTests}</tofu.skipTests>
    <skipTests>false</skipTests>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <workingDirectory>${project.basedir}</workingDirectory>
          <executable>sh</executable>
          <environmentVariables>
            <TOFU>${tofu.executable}</TOFU>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <id>tofu-validate</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${tofu.skip}</skip>
              <arguments>
                <argument>check.sh</argument>
                <argument>validate</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>tofu-test</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${tofu.skip}</skip>
              <arguments>
                <argument>check.sh</argument>
                <argument>test</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- the end-to-end test: a real kind cluster on this machine (Docker or Podman, kind, kubectl, tofu); see e2e/ -->
    <profile>
      <id>kind</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>kind-e2e</id>
                <phase>integration-test</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>e2e/kind-test.sh</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
